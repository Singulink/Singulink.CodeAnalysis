<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="DotNetAnalyzers.DocumentationAnalyzers" Version="1.0.0-beta.59" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Include="PolySharp" Version="1.17.1" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
  </ItemGroup>

  <ItemGroup Label="Roslyn">
    <!-- The oldest compiler the analyzer supports: the one of the .NET 10 SDK. The analyzer does not load in an older one. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Label="Runtime">
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="PrefixClassName.MsTest" Version="2.0.0" />

    <!--
      Not used by the tests themselves. Analyzer.Testing 1.1.4 depends on version 9.0.6 of this package through the NuGet packages that
      it uses, and that version has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7), which fails the restore. The test
      project references this version to replace it. Remove both once Analyzer.Testing depends on a version without them.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <!-- The second target of the tests runs them against the compiler of the newest SDK: the .NET 11 SDK ships version 5.12. -->
  <ItemGroup Label="Roslyn of the newest SDK" Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Update="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Update="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
  </ItemGroup>
</Project>
