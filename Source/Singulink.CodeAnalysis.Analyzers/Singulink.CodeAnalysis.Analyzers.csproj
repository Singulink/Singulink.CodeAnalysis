<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <PackageTags>Analyzer, Roslyn, NonCopyable, Struct, Copy, Lock, Guard</PackageTags>
    <Description>Roslyn analyzers that check code against the Singulink.CodeAnalysis attributes, such as copies of structs marked [NonCopyable]. Has no runtime assembly.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>

    <!-- The package holds the analyzer under analyzers/ only: no lib/ assembly and no dependencies. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

    <!-- The debug symbols are inside the assembly, since the package has no place beside it that a compiler would read them from. -->
    <DebugType>embedded</DebugType>

    <!-- RS2008: the rules are documented in the README; the project keeps no release tracking files. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The safe list for the framework, in the format of the NonCopyableSymbols.txt files that a project can add. -->
    <EmbeddedResource Include="NonCopyableSymbols.txt" LogicalName="Singulink.CodeAnalysis.Analyzers.NonCopyableSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
    <None Include="build\Singulink.CodeAnalysis.Analyzers.props" Pack="true" PackagePath="build;buildTransitive" />
    <None Include="$(IntermediateOutputPath)build\Singulink.CodeAnalysis.Analyzers.targets" Pack="true" PackagePath="build;buildTransitive" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The targets file of the package records the version of the analyzers in the marker of every assembly built with them. The version is
    the package's own, fixed here when the package is built and packed, so it depends neither on where the package is restored to nor on
    a property of the project that uses it. The file under build is written with the version in place of its placeholder, and that copy
    is the one that is packed.
  -->
  <Target Name="_WriteVersionedTargetsFile" BeforeTargets="BeforeBuild;_GetPackageFiles">
    <PropertyGroup>
      <_VersionedTargetsFile>$(IntermediateOutputPath)build\Singulink.CodeAnalysis.Analyzers.targets</_VersionedTargetsFile>
      <_VersionedTargetsText>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\build\Singulink.CodeAnalysis.Analyzers.targets').Replace('&lt;_Parameter2&gt;0.0.0-unpacked&lt;/_Parameter2&gt;', '&lt;_Parameter2&gt;$(PackageVersion)&lt;/_Parameter2&gt;'))))</_VersionedTargetsText>
    </PropertyGroup>

    <Error Condition="!$(_VersionedTargetsText.Contains('&lt;_Parameter2&gt;$(PackageVersion)&lt;/_Parameter2&gt;'))" Text="The version of the marker was not written into the targets file of the package." />
    <WriteLinesToFile File="$(_VersionedTargetsFile)" Lines="$(_VersionedTargetsText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
