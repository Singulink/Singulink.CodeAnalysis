<Project>
  <!--
    The package has this file under build and under buildTransitive, so it runs in every project that gets the analyzer: one that
    references a package of it, and one that only gets it through a library.
  -->

  <!--
    The list files of the project's own folder are read with nothing more written: NonCopyableSymbols.txt and NonCopyableSymbols.*.txt.
    This is a targets file, so the items of the project are known here, and a file that the project adds itself is not added twice. A
    file in another folder is added by the project.
  -->
  <ItemGroup>
    <_NonCopyableSymbolsFile Include="$(MSBuildProjectDirectory)\NonCopyableSymbols.txt" Condition="Exists('$(MSBuildProjectDirectory)\NonCopyableSymbols.txt')" />
    <_NonCopyableSymbolsFile Include="$(MSBuildProjectDirectory)\NonCopyableSymbols.*.txt" />
    <_NonCopyableSymbolsFile Remove="@(AdditionalFiles)" />
    <AdditionalFiles Include="@(_NonCopyableSymbolsFile)" Visible="false" />
    <_NonCopyableSymbolsFile Remove="@(_NonCopyableSymbolsFile)" />
  </ItemGroup>

  <!--
    The marker of an assembly that was built with the analyzer, with the version of the analyzers as its value. Marks that promise a
    checked body, such as [NonCopyable] on a type parameter, are trusted only from an assembly that has it, and a member of an assembly
    without it needs a list entry where it gets at a non-copyable value other than by value. A build that does not run analyzers does
    not get it. NonCopyableErrorsAsWarnings plays no part: it only changes how reports appear and how they are suppressed, and the
    project gets every report all the same. A project with GenerateAssemblyInfo false gets nothing from this item, and writes the
    attribute itself with the version of the analyzers that it is built with, such as:
    [assembly: System.Reflection.AssemblyMetadata("Singulink.CodeAnalysis.Analyzed", "1.0.0")]
    The version is the package's own: pack writes this file with it in place of the value below (see the project file).
  -->
  <ItemGroup Condition="'$(RunAnalyzers)' != 'false' and '$(RunAnalyzersDuringBuild)' != 'false'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Singulink.CodeAnalysis.Analyzed</_Parameter1>
      <_Parameter2>0.0.0-unpacked</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The assets file that NuGet writes for the project says what each package depends on. The analyzer reads it for a package that comes
    with a reference assembly, which does not show what the code of the package uses: such a package gets SCA1025 only for an assembly
    of a package that it depends on. The property is set after this file is read, so the item is added in a target; it runs in a
    design-time build as well.
  -->
  <Target Name="_NonCopyableAddAssetsFile"
          BeforeTargets="CoreCompile"
          Condition="'$(ProjectAssetsFile)' != '' and Exists('$(ProjectAssetsFile)')">
    <ItemGroup>
      <AdditionalFiles Include="$(ProjectAssetsFile)" Visible="false" />
    </ItemGroup>
  </Target>

  <!--
    Whether the project references one of the two packages itself, or only gets the analyzer through a library, is worked out here into
    _NonCopyableReferencesPackage, always and whatever else the project sets. Two things depend on it. The built-in non-copyable types
    are on in a project that references a package, and off in one that does not: a library that marks its guards brings the analyzer to
    everyone who uses it, and must not bring findings about their own GCHandle code with it. A project that sets
    NonCopyableIncludeBuiltInTypes keeps its value. And SCA1025, an assembly that was not built with the analyzer, is a warning in a
    project that references a package and a message in one that does not, which did not choose to check what it references. The items
    of the project are not known when properties are evaluated, so this runs as a target, before the compiler-visible properties are
    written for the compiler; it runs in a design-time build as well.
  -->
  <Target Name="_NonCopyableFindPackageReference" BeforeTargets="GenerateMSBuildEditorConfigFileCore">
    <ItemGroup>
      <_NonCopyablePackageReference Include="@(PackageReference)" Condition="'%(Identity)' == 'Singulink.CodeAnalysis' or '%(Identity)' == 'Singulink.CodeAnalysis.Analyzers'" />
    </ItemGroup>

    <PropertyGroup>
      <_NonCopyableReferencesPackage Condition="'@(_NonCopyablePackageReference)' != ''">true</_NonCopyableReferencesPackage>
      <_NonCopyableReferencesPackage Condition="'@(_NonCopyablePackageReference)' == ''">false</_NonCopyableReferencesPackage>
      <NonCopyableIncludeBuiltInTypes Condition="'$(NonCopyableIncludeBuiltInTypes)' == ''">$(_NonCopyableReferencesPackage)</NonCopyableIncludeBuiltInTypes>
    </PropertyGroup>

    <ItemGroup>
      <_NonCopyablePackageReference Remove="@(_NonCopyablePackageReference)" />
    </ItemGroup>
  </Target>
</Project>
