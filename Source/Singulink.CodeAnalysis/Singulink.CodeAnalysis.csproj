<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- On .NET 10 the type parameters of NonCopyable allow a ref struct; a project on an older framework gets the .NET Standard 2.0 assembly. -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <PackageTags>Analyzer, Roslyn, Attributes, NonCopyable, Struct, Copy, Move</PackageTags>
    <PolySharpIncludeGeneratedTypes>System.Diagnostics.CodeAnalysis.MaybeNullAttribute;System.Runtime.CompilerServices.CallerArgumentExpressionAttribute</PolySharpIncludeGeneratedTypes>
    <Description>Attributes that mark types and members for the Singulink.CodeAnalysis analyzers, such as [NonCopyable] for structs that must not be copied, and the NonCopyable.Move helper. Brings the analyzers with it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Packs as a dependency on Singulink.CodeAnalysis.Analyzers with all assets included (PrivateAssets="none"), so a project that references this
      package gets the analyzers too; the default would exclude them. The reference must keep ReferenceOutputAssembly at its default: restore leaves
      out a project reference that sets it to false, and then pack writes no dependency at all. Private="false" keeps the analyzer out of bin.
    -->
    <ProjectReference Include="..\Singulink.CodeAnalysis.Analyzers\Singulink.CodeAnalysis.Analyzers.csproj" PrivateAssets="none" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The attributes that .NET Standard 2.0 lacks and the helpers of NonCopyable use, as the analyzer project gets its own. -->
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The marker of an assembly that was built with the analyzer, which the targets file of the package adds to every project that it
      runs in. This repository references the analyzer as a project, where that file does not run, so the attributes assembly adds the
      marker itself: the marks of NonCopyable.Move and of the two checks are trusted only from an assembly that has it. Its value is the
      version of the analyzers, which is this package's own version: the two are built and published together.
    -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Singulink.CodeAnalysis.Analyzed</_Parameter1>
      <_Parameter2>$(Version)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- .NET Standard 2.0 has no way to test a reference for null without it, which NonCopyable.ThrowIfNullRef does. -->
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
  </ItemGroup>
</Project>
